{
  "name": "det",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Expense Tracker — Next.js full-stack app (Admin UI + REST API for Flutter mobile)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "db:check": "node scripts/db-check.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "audit:indexes": "node scripts/index-audit.js",
    "analyze": "ANALYZE=true next build",
    "loadtest:dashboard": "k6 run scripts/loadtest/dashboard.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:build": "next build && playwright test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.6",
    "mongoose": "^8.5.1",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.5",
    "@playwright/test": "^1.47.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@google-cloud/vision": "^5.3.7",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.9.14",
    "plaid": "^42.2.0",
    "twilio": "^6.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEach": [
      "<rootDir>/tests/setup.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "globalTeardown": "<rootDir>/tests/global-teardown.js",
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/index.js",
      "!**/node_modules/**"
    ]
  }
}
