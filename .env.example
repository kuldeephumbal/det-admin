# Next.js environment file.
#   Local dev: copy to .env.local  (gitignored, auto-loaded by Next.js)
#   Production: set these in your hosting provider's env config

# Public URL of the app (used for password-reset emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/det-dev

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Password reset
RESET_TOKEN_EXPIRES_IN=15m

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated). Use * to allow all (mobile + any web client).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info

# Mail (optional — falls back to console when not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DET <no-reply@det.app>"

# Cron / worker
#   Requests to /api/cron/* must carry header `x-cron-secret: <CRON_SECRET>`.
#   In production: generate a strong random string. Vercel cron sets a header
#   you can map; self-hosted: configure a system cron to curl with this header.
CRON_SECRET=replace_with_random_string

# Observability (optional)
#   Set SENTRY_DSN to enable error reporting. The runtime falls back to a
#   no-op if @sentry/node isn't installed (see lib/observability/sentry.js).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=
